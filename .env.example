# Copy to .env and fill in. Both are safe in a build: the anon key is designed
# to be public and already ships in the mobile app binary. The SERVICE ROLE key
# must never appear here — it belongs only in the edge function's secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
